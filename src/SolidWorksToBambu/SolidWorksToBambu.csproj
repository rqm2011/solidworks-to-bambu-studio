<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" Condition="false" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{D291414B-A19D-465B-8203-95711489A21D}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SolidWorksToBambu</RootNamespace>
    <AssemblyName>SolidWorksToBambu</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RegisterForComInterop>false</RegisterForComInterop>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <SolidWorksInstallDir Condition=" '$(SolidWorksInstallDir)' == '' ">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksInstallDir>
    <SolidWorksApiRedistDir Condition=" '$(SolidWorksApiRedistDir)' == '' ">$(SolidWorksInstallDir)\api\redist</SolidWorksApiRedistDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SolidWorksTools">
      <HintPath>$(SolidWorksInstallDir)\SolidWorksTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiRedistDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiRedistDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiRedistDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- This workstation transparently encrypts .cs files. MSBuild/csc accepts .csx
         as regular Compile items, so the source stays readable and reviewable. -->
    <Compile Include="Core.csx" />
    <Compile Include="IconFactory.csx" />
    <Compile Include="Properties\AssemblyInfo.csx" />
    <Compile Include="SettingsForm.csx" />
    <Compile Include="SwAddin.csx" />
  </ItemGroup>
  <Target Name="CheckSolidWorksReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SolidWorksApiRedistDir)\SolidWorks.Interop.sldworks.dll')"
           Text="找不到 SOLIDWORKS API 程序集。请通过 /p:SolidWorksApiRedistDir=&quot;...\api\redist&quot; 指定 SOLIDWORKS 2025 API redist 目录。当前值: $(SolidWorksApiRedistDir)" />
    <Error Condition="!Exists('$(SolidWorksInstallDir)\SolidWorksTools.dll')"
           Text="找不到 SolidWorksTools.dll。当前 SOLIDWORKS 目录: $(SolidWorksInstallDir)" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
